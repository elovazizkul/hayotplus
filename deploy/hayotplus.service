[Unit]
Description=Hayot Plus sayti
After=network.target

[Service]
User=hayot
WorkingDirectory=/opt/hayotplus
EnvironmentFile=/etc/hayotplus.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
