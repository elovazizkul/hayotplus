# Serverda bu fayl deploy/deploy.sh tomonidan avtomatik yaratiladi.
# Lokal ishlash uchun .env ga nusxalang. Haqiqiy qiymatlarni GitHub'ga yuklamang.

# Baza paroli (faqat harf va raqam)
POSTGRES_PASSWORD=
# Kalitlarni shifrlash uchun, kamida 32 belgi. O'zgartirilsa, saqlangan kalitlar o'qilmay qoladi.
APP_SECRET=
# Birinchi kirish paroli, kamida 10 belgi. Keyin admin paneldan o'zgartiriladi.
ADMIN_PASSWORD=
# Domen(lar). Caddy HTTPS sertifikatini o'zi oladi.
SITE_ADDRESS=hayotplus.uz, www.hayotplus.uz

# Docker'siz ishga tushirganda kerak
# DATABASE_URL=postgres://hayotplus:parol@localhost:5432/hayotplus

# Anthropic API kaliti, Telegram token va boshqalar .env'da emas:
# ular admin panelda (AI va Telegram bo'limi) kiritiladi.
