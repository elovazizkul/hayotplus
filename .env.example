# Bu fayl — namuna. Haqiqiy kalitlarni Vercel → Project → Settings → Environment Variables bo'limiga kiriting.
# Bu yerga haqiqiy kalit YOZMANG va GitHub'ga yuklamang.

# 1) AI yordamchi (Claude API). console.anthropic.com dan olinadi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: model nomi (bo'sh qoldirilsa claude-haiku-5-5 ishlatiladi — eng arzon va tez)
ANTHROPIC_MODEL=

# 2) Arizalar (emlashga yozilish, aloqa formasi) Telegram'ga keladi.
# @BotFather orqali bot yarating → token. Botni guruhga qo'shing → guruh ID (masalan -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) Ixtiyoriy: arizalarni n8n'ga ham yuborish (Webhook node URL manzili)
LEAD_WEBHOOK_URL=
