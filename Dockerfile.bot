# Natijalar boti: Node + Chromium (laboratoriya blankini PDF qilish uchun).
# Sayt (Dockerfile) bilan bir xil kod, lekin alohida konteyner: bot PDF tayyorlayotganda
# ko'p xotira olsa ham, sayt ishlashda davom etadi.
FROM node:22-alpine
RUN apk add --no-cache chromium nss freetype harfbuzz ttf-dejavu font-noto
ENV NODE_ENV=production \
    CHROMIUM_PATH=/usr/bin/chromium-browser
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY server ./server
COPY api ./api
COPY src/data ./src/data
USER node
CMD ["node", "server/bot/index.js"]
